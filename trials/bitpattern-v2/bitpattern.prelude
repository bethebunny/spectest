# Helpers for bitpattern.spec: small-set views and list set algebra.

fn imax(a: int, b: int) -> int = if a > b then a else b
fn imin(a: int, b: int) -> int = if a < b then a else b

# The members of a set of at most 512 elements, ascending.
fn small(s: bitpattern.intset.IntSet) -> bool = s.size <= 512
fn elems(s: bitpattern.intset.IntSet) -> list<int> = s.head(s.size)

fn union_of(a: list<int>, b: list<int>) -> list<int> = sorted(a + filter(x in b: not (x in a)))
fn inter_of(a: list<int>, b: list<int>) -> list<int> = filter(x in a: x in b)
fn minus_of(a: list<int>, b: list<int>) -> list<int> = filter(x in a: not (x in b))
fn xor_of(a: list<int>, b: list<int>) -> list<int> = sorted(minus_of(a, b) + minus_of(b, a))
fn subset_of(a: list<int>, b: list<int>) -> bool = all(x in a: x in b)
fn same_members(a: list<int>, b: list<int>) -> bool = subset_of(a, b) and subset_of(b, a)

# Decimal text of a non-negative integer below 10 ** 80.
fn ndigits(n: int) -> int = if n < 10 then 1 else len(filter(i in range(0, 80): 10 ** i <= n))
fn dec(n: int) -> string = from_codepoints(map(i in range(0, ndigits(n)): 48 + (n // 10 ** (ndigits(n) - 1 - i)) % 10))

# Slice positions of range(n)[start:stop:step] for a nonzero step, as Python normalises them.
fn wrap_index(v: int, n: int) -> int = if v < 0 then v + n else v
fn slice_lo(start: option<int>, n: int, step: int) -> int = if is_none(start) then (if step > 0 then 0 else n - 1) else (if step > 0 then imax(0, imin(n, wrap_index(unwrap(start), n))) else imax(-1, imin(n - 1, wrap_index(unwrap(start), n))))
fn slice_hi(stop: option<int>, n: int, step: int) -> int = if is_none(stop) then (if step > 0 then n else -1) else (if step > 0 then imax(0, imin(n, wrap_index(unwrap(stop), n))) else imax(-1, imin(n - 1, wrap_index(unwrap(stop), n))))
fn slice_positions(start: option<int>, stop: option<int>, step: int, n: int) -> list<int> = if step > 0 then filter(i in range(slice_lo(start, n, step), slice_hi(stop, n, step)): (i - slice_lo(start, n, step)) % step == 0) else filter(i in range(slice_hi(stop, n, step) + 1, slice_lo(start, n, step) + 1): (slice_lo(start, n, step) - i) % (-step) == 0)

# BDD helpers.
fn cell_bit(cell: "0" | "1" | "?") -> int = if cell == "1" then 1 else 0
fn cells_match(cells: list<"0" | "1" | "?">, x: int) -> bool = all(i in range(0, len(cells)): cells[i] == "?" or cell_bit(cells[i]) == (x >> (len(cells) - 1 - i)) & 1)

# Does path p (over 0 1 ?, most significant bit first) contain x?
fn path_matches(p: string, x: int) -> bool = all(i in range(0, len(p)): codepoints(p)[i] == 63 or codepoints(p)[i] - 48 == (x >> (len(p) - 1 - i)) & 1)

# bitpattern.bdd.count_repr: decimal, or "2**k" for an exact power of two with k >= 10.
fn is_big_pow2(n: int) -> bool = n >= 1024 and n & (n - 1) == 0
fn count_repr_text(n: int) -> string = if is_big_pow2(n) then "2**" + dec(bit_length(n) - 1) else dec(n)
