(use "other.spec")
(prelude "bitpattern.prelude")
(error "TypeError")
(error "bitpattern.PatternError")
(const "bitpattern.codecs.int8" (type "bitpattern.Codec"))
(const "bitpattern.codecs.uint16" (type "bitpattern.Codec"))
(enum "Side" (name "left") (name "right"))
(record "Pair" (param "first" (type "int") _) (param "second" (type "int") (num "0")))
(alias "Codecs" (choice_type (qname "bitpattern.codecs.int8") (qname "bitpattern.codecs.uint16")))
(alias "Mode" (choice_type (str "wrap") (str "saturate")))
(model "bitpattern.IntSet" (tparams (tparam "T" (qname "Ord"))) (observe "width" _ (type "int") _) (observe "members" _ (type "list" (type "int")) (call (attr "list" (name "builtins")) (typeargs) (arg (name "self")))) (observe "has" (params (param "x" (type "int") _)) (type "bool") (binary in (name "x") (name "members"))) (build "bitpattern.IntSet" (params (param "items" (type "list" (type "int")) _) (param "width" (type "int") (num "8")))) (build "bitpattern.IntSet.range" (params (param "lo" (type "int") _) (param "hi" (type "int") _))) (clause invariant "ascending" (call (name "is_sorted") (typeargs) (arg (name "members")))) (clause invariant (binary or (binary <= (unary neg (binary ** (name "width") (num "2"))) (num "0")) (binary >= (binary << (binary >> (name "width") (num "1")) (num "2")) (num "0")))))
(fn "bitpattern.IntSet.__or__" (tparams) (params (param "self" _ _) (param "other" (type "bitpattern.IntSet") _)) (type "bitpattern.IntSet") (partition "other" (class "empty" (call (attr "range" (attr "IntSet" (name "bitpattern"))) (typeargs) (arg (num "0")) (arg (num "0")))) (class "rest" (binary - (attr "IntSet" (name "bitpattern")) (name "empty")))) (clause requires (binary == (attr "width" (name "self")) (attr "width" (name "other")))) (clause ensures (binary == (call (name "members") (typeargs) (arg (name "result"))) (call (name "sorted") (typeargs) (arg (binary | (call (name "members") (typeargs) (arg (name "self"))) (call (name "members") (typeargs) (arg (name "other")))))))) (clause raises (qname "bitpattern.PatternError") (binary != (attr "width" (name "self")) (attr "width" (name "other")))) (clause may_raise (qname "bitpattern.PatternError") _) (clause may_raise "late" (qname "bitpattern.PatternError") (binary > (attr "width" (name "other")) (num "64"))) (clause modifies (name "self") (name "other")) (clause perf (str "O(n log n) in the size of the sets")))
(fn "bitpattern.encode" (tparams) (params (param "x" (type "int") _) (param "codec" (choice_type (qname "bitpattern.codecs.int8") (qname "bitpattern.codecs.uint16")) _)) (type "bytes") (clause ensures (binary >= (binary ** (name "x") (num "2")) (num "0"))))
(fn "cos" (tparams) (params (param "x" (type "f64") _)) (type "f64") (clause unspecified (name "rounding")) (clause impl_defined (name "payload")))
(def "double" (tparams) (params (param "x" (type "int") _)) (type "int") (binary * (name "x") (num "2")))
(def "clamp" (tparams (tparam "T" (qname "Ord"))) (params (param "x" (type "T") _) (param "lo" (type "T") _) (param "hi" (type "T") _)) (type "T") (if (binary < (name "x") (name "lo")) (name "lo") (if (binary > (name "x") (name "hi")) (name "hi") (name "x"))))
(interface "bitpattern.Stack" (tparams (tparam "T")) (observe "items" _ (type "list" (type "T")) _) (ctor "empty" (tparams) (params) (type "bitpattern.Stack" (type "T"))) (method "push" (tparams) (params (param "self" _ _) (param "x" (type "T") _)) _ (clause ensures (binary == (call (name "items") (typeargs) (arg (name "self"))) (binary | (call (name "items") (typeargs) (arg (name "old"))) (list (name "x")))))) (method "pop" (tparams) (params (param "self" _ _)) (type "T") (clause raises (qname "IndexError") (binary == (call (name "len") (typeargs) (arg (call (name "items") (typeargs) (arg (name "self"))))) (num "0")))) (clause invariant "bounded" (binary <= (call (name "len") (typeargs) (arg (name "items"))) (num "10"))))
